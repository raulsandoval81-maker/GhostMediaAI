/* GHOST MEDIA HAMBURGER NAV V1 */

.gm-nav-shell {
  position: relative;
  z-index: 1000;
  margin: 12px 0 18px;
}

.gm-menu-button {
  display: inline-flex;
  align-items: center;
  gap: 10px;

  min-height: 44px;
  padding: 10px 16px;

  border: 1px solid rgba(255,255,255,.16);
  border-radius: 12px;

  background: rgba(15,15,20,.82);
  color: #fff;

  font-size: .95rem;
  font-weight: 800;

  cursor: pointer;
}

.gm-menu-icon {
  font-size: 1.25rem;
  line-height: 1;
}

.gm-nav-backdrop {
  position: fixed;
  inset: 0;

  background: rgba(0,0,0,.64);

  opacity: 0;
  visibility: hidden;

  transition:
    opacity .2s ease,
    visibility .2s ease;

  z-index: 1998;
}

.gm-nav-backdrop.open {
  opacity: 1;
  visibility: visible;
}

.gm-nav-drawer {
  position: fixed;

  top: 0;
  left: 0;

  width: min(340px, 88vw);
  height: 100dvh;

  padding: 18px;

  background:
    linear-gradient(
      180deg,
      rgba(18,18,24,.99),
      rgba(5,5,8,.99)
    );

  border-right:
    1px solid rgba(255,255,255,.12);

  box-shadow:
    20px 0 60px rgba(0,0,0,.5);

  transform: translateX(-105%);

  transition:
    transform .25s ease;

  overflow-y: auto;

  z-index: 1999;
}

.gm-nav-drawer.open {
  transform: translateX(0);
}

.gm-drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding-bottom: 16px;
  margin-bottom: 14px;

  border-bottom:
    1px solid rgba(255,255,255,.1);

  font-size: 1.1rem;
}

.gm-menu-close {
  width: 42px;
  height: 42px;

  border: 0;
  border-radius: 10px;

  background: rgba(255,255,255,.07);
  color: white;

  font-size: 1.6rem;

  cursor: pointer;
}

.gm-menu-links,
.gm-advanced-links {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.gm-menu-link {
  display: block;

  padding: 12px 13px;

  border-radius: 10px;

  color: rgba(255,255,255,.82);
  text-decoration: none;

  font-weight: 700;

  transition: .18s ease;
}

.gm-menu-link:hover {
  background: rgba(255,255,255,.07);
  color: #fff;
}

.gm-menu-link.active {
  background: rgba(255,255,255,.12);
  color: #fff;
}

.gm-advanced-menu {
  margin-top: 18px;

  border-top:
    1px solid rgba(255,255,255,.1);

  padding-top: 14px;
}

.gm-advanced-menu summary {
  cursor: pointer;

  padding: 10px 12px;

  font-weight: 800;
  color: rgba(255,255,255,.72);
}

.gm-advanced-links {
  margin-top: 8px;
}

body.gm-menu-open {
  overflow: hidden;
}

/* Desktop keeps the same clean navigation.
   Drawer simply has a little more room. */

@media (min-width: 900px) {

  .gm-nav-drawer {
    width: 360px;
  }

}

/* Phone */

@media (max-width: 600px) {

  .gm-nav-shell {
    margin: 8px 0 14px;
  }

  .gm-menu-button {
    width: 100%;
    justify-content: flex-start;
  }

}

