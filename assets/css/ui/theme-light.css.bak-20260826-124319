/* GHOST MEDIA DASHBOARD SNAPSHOT V3 */

#ghostCounts {
  width: 100%;
  margin-top: 12px;
}

.gm-snapshot-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.gm-snapshot-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 11px;

  min-height: 76px;

  padding: 12px;

  background:
    linear-gradient(
      180deg,
      #f8f2e8,
      #eee4d5
    );

  border: 1px solid #b7aa96;
  border-top: 3px solid #2550d8;
  border-radius: 12px;

  box-shadow:
    0 4px 12px rgba(28, 38, 58, .10);
}

.gm-snapshot-icon {
  font-size: 1.55rem;
  line-height: 1;
}

.gm-snapshot-copy {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.gm-snapshot-copy strong {
  color: #111827 !important;
  font-size: 1.3rem;
  line-height: 1;
  font-weight: 900;
}

.gm-snapshot-copy span {
  color: #27364d !important;
  font-size: .82rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .04em;
}

@media (max-width: 700px) {
  .gm-snapshot-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .gm-snapshot-tile {
    min-height: 70px;
    padding: 9px 6px;
    gap: 6px;
  }

  .gm-snapshot-icon {
    font-size: 1.2rem;
  }

  .gm-snapshot-copy strong {
    font-size: 1.1rem;
  }

  .gm-snapshot-copy span {
    font-size: .68rem;
    letter-spacing: 0;
  }
}

@media (max-width: 390px) {
  .gm-snapshot-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

